# ChromaDB configuration
CHROMA_MODE="server or cloud"

### If CHROMA_MODE is "server" ###
CHROMA_HOST="your_chromadb_host"
CHROMA_PORT=your_chromadb_port

### If CHROMA_MODE is "cloud" ###
CHROMA_TENANT="your_chromadb_tenant"
CHROMA_API_KEY="your_chromadb_api_key"

# OpenAI API Key
OPENAI_API_KEY="your_openai_api_key"
MODEL_NAME_EMBEDDING="your_model_name_embedding"

# Chunking settings
CHUNK_SIZE=your_chunk_size
CHUNK_OVERLAP=your_chunk_overlap

# OCR settings
ENGINE="your_ocr_engine_default_easyocr"

# API settings
HOST="your_api_host"
PORT=your_api_port
RELOAD=true_or_false

# LangSmith configuration (optional but recommended)
LANGSMITH_API_KEY="your_langsmith_api_key"
